<lccdd>
  <define>
    <comment>
      Main parameters
    </comment>

    <!-- Dimensions -->
    <constant name="MAXLENGTH"        value="ForwardRICHRegion_zmin+BackwardPIDRegion_zmin- 1*cm -1*cm"/>  <!-- full length of the vessel -->
    <constant name="DCH_z0"           value="ForwardRICHRegion_zmin - MAXLENGTH/2.0"/>

    <constant name="innerRadiusLimit"       value=" 140 *mm "/>
    <constant name="outerRadiusLimit"       value=" 1150 * mm "  />
    <constant name="vesselShellThickness"   value="1*mm"/>
    <constant name="vesselFillingThickness" value="25*cm"/>
    <constant name="gasRadiusLimit"         value="outerRadiusLimit-innerRadiusLimit-2*vesselShellThickness"/> <!-- 1008 mm -->

    <constant name="Layer_length"           value="MAXLENGTH/2.0-2*vesselShellThickness-vesselFillingThickness"/>   <!-- half length -->
    <constant name="Layer_rmin"             value="innerRadiusLimit+vesselShellThickness"/> -->
    
    <constant name="Layer_thickness"        value="1.4*cm"/>
    <constant name="Layer_buffer"           value="2*mm"/>  <!-- buffer between layers --> 
    <constant name="numLayer"               value="22"/> <!-- gasRadiusLimit/(Layer_thickness+Layer_buffer)"/> -->
    <constant name="nPhibin"                value="120"/>
    <constant name="Sensor_thickness"       value="1*um"/>
  </define>

  <display>
    <vis name="moduleVis"
         alpha="1.0" r="0.2" g="0.5" b="1"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/>
    <vis name="layer1Vis"
         alpha="0.3" r="0.8" g="0" b="0"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/>
     <vis name="layer2Vis"
         alpha="0.3" r="0.6" g="0" b="0.4"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/>
     <vis name="layer3Vis"
         alpha="0.1" r="0.4" g="0" b="0.6"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/>
    <vis name="swireVis"
         alpha="1" r="0.1" g="1" b="0.1"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/>
    <vis name="fwireVis"
         alpha="1" r="0.1" g="1" b="1"
         drawingStyle="solid"
         showDaughters="true"
         visible="true"/> 
    <vis name="vesselVis"
	 alpha="0.3" r="0.8" g="0.8" b="0"
         drawingStyle="wire"
         showDaughters="true"
         visible="true"/>  
  </display>

  <detectors>
    <documentation level="5">
      ### Actual detectors
    </documentation>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                    vessel                       -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <comment>
    <detector
	id  ="DCH_vessel_0_ID"
	name="DCH_vessel"
	type="D2EIC_DCH_vessel"
	>
      <dimensions
          rmin="innerRadiusLimit"
          rmax="outerRadiusLimit"
          length="MAXLENGTH" />
      <constructionFlag showVessel="false"/>
      <vessel
          build="true"
          tShell="vesselShellThickness"
          tFill="vesselFillingThickness"
          shellMat="CarbonFibStr"
          fillMat="PolystyreneFoam"
          vis="vesselVis">
      </vessel>
    </detector>
    </comment>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                  Inner DCH                      -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <detector
	id="DCH_0_ID"
	name="DCH_inner"
	type="D2EIC_DCH"
	readout="DCH_Hits"
	insideTrackingVolume="true">

      <type_flags type="DetType_TRACKER + DetType_BARREL"/>

      <dimensions
          rmin="innerRadiusLimit"
          rmax="innerRadiusLimit+numLayer*Layer_thickness"
          length="MAXLENGTH" />   <!-- layer length + vessel endcaps -->
      
      <constructionFlag maxLayer="numLayer" showLayer="True" showSensor="false" showSwire="true" showFwire="true"/>

      <gas material="GasHe_90Isob_10" />  
      
      <wires
          buildSenseWires="true"
          buildFieldWires="true"
	  SWire_vis="swireVis"
	  FWire_vis="fwireVis"
	  SWire_thickness       ="0.0304*mm" 
          FSideWire_thickness   ="0.0403*mm"
          FCentralWire_thickness="0.0503*mm"
          SWire_material        ="CarbonFiber"
          FSideWire_material    ="Copper"
          FCentralWire_material ="Copper"
	  alpha                 ="0*deg">
      </wires>
      <!-- https://doi.org/10.1016/j.nima.2017.03.001 -->
      
      <module name="Module"
	      build="true"
              sensitive="true"
              thickness="Sensor_thickness"
	      length="Layer_length"
              vis="moduleVis" />

      <layer repeat="numLayer" Layer_rmin="Layer_rmin" module="Module" vis="layer1Vis">
	<layer_material surface="inner" binning="binPhi,binZ" bins0="nPhibin" bins1="100" />
      </layer>
    </detector>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                   mid DCH                       -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <detector
        id="DCH_1_ID"
        name="DCH_mid"
        type="D2EIC_DCH"
        readout="DCH_Hits"
        insideTrackingVolume="true">

      <type_flags type="DetType_TRACKER + DetType_BARREL"/>

      <dimensions
          rmin="innerRadiusLimit+numLayer*Layer_thickness+Layer_buffer"
          rmax="innerRadiusLimit+2*numLayer*Layer_thickness+Layer_buffer"
          length="MAXLENGTH" />   <!-- layer length + vessel endcaps -->

      <constructionFlag maxLayer="numLayer" showLayer="True" showSensor="false" showSwire="true" showFwire="true"/>

      <gas material="GasHe_90Isob_10" />

      <wires
          buildSenseWires="true"
          buildFieldWires="true"
          SWire_vis="swireVis"
          FWire_vis="fwireVis"
          SWire_thickness       ="0.0304*mm"
          FSideWire_thickness   ="0.0403*mm"
          FCentralWire_thickness="0.0503*mm"
          SWire_material        ="CarbonFiber"
          FSideWire_material    ="Copper"
          FCentralWire_material ="Copper"
          alpha                 ="0*deg">
      </wires>

      <module name="Module"
              build="true"
              sensitive="true"
              thickness="Sensor_thickness"
              length="Layer_length"
              vis="moduleVis" />

      <layer repeat="numLayer" Layer_rmin="Layer_rmin+numLayer*Layer_thickness+Layer_buffer" module="Module" vis="layer2Vis">
        <layer_material surface="inner" binning="binPhi,binZ" bins0="nPhibin" bins1="100" />
      </layer>
    </detector>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                   outer DCH                     -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <detector
        id="DCH_2_ID"
        name="DCH_outer"
        type="D2EIC_DCH"
        readout="DCH_Hits"
        insideTrackingVolume="true">

      <type_flags type="DetType_TRACKER + DetType_BARREL"/>

      <dimensions
          rmin="innerRadiusLimit+2*numLayer*Layer_thickness+2*Layer_buffer"
          rmax="outerRadiusLimit+2*Layer_buffer"
          length="MAXLENGTH" />   <!-- layer length + vessel endcaps -->

      <constructionFlag maxLayer="numLayer" showLayer="True" showSensor="false" showSwire="true" showFwire="true"/>

      <gas material="GasHe_90Isob_10" />

      <wires
          buildSenseWires="true"
          buildFieldWires="true"
          SWire_vis="swireVis"
          FWire_vis="fwireVis"
          SWire_thickness       ="0.0304*mm"
          FSideWire_thickness   ="0.0403*mm"
          FCentralWire_thickness="0.0503*mm"
          SWire_material        ="CarbonFiber"
          FSideWire_material    ="Copper"
          FCentralWire_material ="Copper"
          alpha                 ="0*deg">
      </wires>
      <!-- https://doi.org/10.1016/j.nima.2017.03.001 -->

      <module name="Module"
              build="true"
              sensitive="true"
              thickness="Sensor_thickness"
              length="Layer_length"
              vis="moduleVis" />

      <layer repeat="numLayer" Layer_rmin="Layer_rmin+2*numLayer*Layer_thickness+2*Layer_buffer" module="Module" vis="layer3Vis">
        <layer_material surface="inner" binning="binPhi,binZ" bins0="nPhibin" bins1="100" />
      </layer>
    </detector>
  </detectors>

  <plugins>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                  Inner DCH                      -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <plugin name="DD4hep_ParametersPlugin">
      <argument value="DCH_inner"/>
      <argument value="layer_pattern: str=DCH_inner_layer\d"/>
    </plugin>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                    mid DCH                      -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <plugin name="DD4hep_ParametersPlugin">
      <argument value="DCH_mid"/>
      <argument value="layer_pattern: str=DCH_mid_layer\d"/>
    </plugin>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--                  outer DCH                      -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <plugin name="DD4hep_ParametersPlugin">
      <argument value="DCH_outer"/>
      <argument value="layer_pattern: str=DCH_outer_layer\d"/>
    </plugin>

  </plugins>
  
  <readouts>
    <readout name="DCH_Hits">
      <segmentation type="CartesianGridXY" grid_size_x="0.050*mm" grid_size_y="0.050*mm" />
      <id>system:4,layer:10,module:16,sensor:1,x:32:-16,y:-16</id>
    </readout>
  </readouts>

</lccdd>


